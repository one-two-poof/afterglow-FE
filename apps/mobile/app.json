{
  "expo": {
    "name": "afterglow",
    "slug": "afterglow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "afterglow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dunaduneos.afterglow",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "nmap",
          "kakaomap"
        ]
      },
      "appleTeamId": "Y5DU5VTQ57"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dunaduneos.afterglow",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치를 지도에 표시하기 위해 위치 권한이 필요합니다."
        }
      ],
      "./plugins/withDisableScriptSandboxing",
      "expo-localization",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "81169082-9e3c-4155-916c-18cd8f3a1c5e"
      }
    },
    "owner": "dunaduneos-team"
  }
}
