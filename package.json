{
  "name": "afterglow",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "perf:map:report": "node scripts/map-performance-report.mjs",
    "health:check": "node scripts/health-check.mjs",
    "status:build": "node scripts/build-status-page.mjs",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:map-performance-report": "node --test scripts/map-performance-report.test.mjs",
    "test:scripts": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.6",
    "typescript": "^5.9.3"
  }
}
